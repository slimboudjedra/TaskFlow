
@model TaskFlow.Models.TaskItem

@{
    ViewData["Title"] = "Aufgabe bearbeiten";
}

<div class="container py-4">
    <!-- En-tête -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge text-bg-primary">TaskFlow</span>
                <span class="text-body-secondary small">Aufgabenverwaltung</span>
            </div>

            <h1 class="h2 fw-bold mb-1">Aufgabe bearbeiten</h1>
            <p class="text-body-secondary mb-0">
                Aktualisiere die Informationen deiner Aufgabe.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Zurück zur Liste
        </a>
    </div>

    <!-- Formulaire -->
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-body border-bottom px-4 py-3">
                    <h2 class="h5 fw-semibold mb-1">Aufgabendetails</h2>
                    <p class="text-body-secondary small mb-0">
                        Ändere die gewünschten Felder und speichere deine Änderungen.
                    </p>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert"></div>

                        <input type="hidden" asp-for="Id" />

                        <!-- Titel -->
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold"></label>
                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="Titel der Aufgabe eingeben" />
                            <span asp-validation-for="Title"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Beschreibung -->
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Beschreibung hinzufügen (optional)"></textarea>
                            <span asp-validation-for="Description"
                                  class="text-danger small"></span>
                        </div>

                        <div class="row g-3">
                            <!-- Priorité -->
                            <div class="col-12 col-md-6">
                                <label asp-for="Priority" class="form-label fw-semibold"></label>
                                <select asp-for="Priority"
                                        asp-items="Html.GetEnumSelectList<TaskFlow.Models.TaskPriority>()"
                                        class="form-select">
                                </select>
                                <span asp-validation-for="Priority"
                                      class="text-danger small"></span>
                            </div>

                            <!-- Statut -->
                            <div class="col-12 col-md-6">
                                <label asp-for="Status" class="form-label fw-semibold"></label>
                                <select asp-for="Status"
                                        asp-items="Html.GetEnumSelectList<TaskFlow.Models.TaskStatus>()"
                                        class="form-select">
                                </select>
                                <span asp-validation-for="Status"
                                      class="text-danger small"></span>
                            </div>

                            <!-- Date d'échéance -->
                            <div class="col-12">
                                <label asp-for="DueDate" class="form-label fw-semibold"></label>
                                <input asp-for="DueDate"
                                       type="date"
                                       class="form-control" />
                                <div class="form-text">
                                    Optional – lege bei Bedarf ein Fälligkeitsdatum fest.
                                </div>
                                <span asp-validation-for="DueDate"
                                      class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 border-top mt-4 pt-4">
                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Abbrechen
                            </a>

                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i>
                                Änderungen speichern
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-body-secondary small mt-3">
                <i class="bi bi-info-circle me-1"></i>
                Prüfe deine Änderungen, bevor du sie speicherst.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
