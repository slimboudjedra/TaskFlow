
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - TaskFlow</title>

    <script type="importmap"></script>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Styles existants du projet -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TaskFlow.styles.css" asp-append-version="true" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body class="d-flex flex-column min-vh-100 bg-body">

    <!-- Navigation -->
    <header>
        <nav class="navbar navbar-expand-lg bg-white border-bottom shadow-sm sticky-top">
            <div class="container py-2">

                <!-- Logo -->
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold fs-4"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-3"
                          style="width: 42px; height: 42px;">
                        <i class="bi bi-check2-square fs-4"></i>
                    </span>

                    <span class="text-dark">Task<span class="text-primary">Flow</span></span>
                </a>

                <!-- Bouton mobile -->
                <button class="navbar-toggler border-0 shadow-none"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Menü öffnen oder schließen">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Liens de navigation -->
                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2 mt-3 mt-lg-0">

                        <li class="nav-item">
                            <a class="nav-link px-3"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>
                                Startseite
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link px-3"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="funktionen">
                                <i class="bi bi-grid me-1"></i>
                                Funktionen
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link px-3"
                               asp-area=""
                               asp-controller="TaskItems"
                               asp-action="Index">
                                <i class="bi bi-list-task me-1"></i>
                                Meine Aufgaben
                            </a>
                        </li>

                        <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                            <a class="btn btn-primary rounded-3 px-4"
                               asp-area=""
                               asp-controller="TaskItems"
                               asp-action="Create">
                                <i class="bi bi-plus-lg me-1"></i>
                                Neue Aufgabe
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Contenu principal -->
    <main role="main" class="flex-grow-1 py-4">
        @RenderBody()
    </main>

    <!-- Pied de page -->
    <footer class="bg-body-tertiary border-top mt-auto">
        <div class="container py-4">

            <div class="row align-items-center g-3">

                <div class="col-12 col-md-6 text-center text-md-start">
                    <a class="text-decoration-none fw-bold fs-5 text-dark"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Index">
                        Task<span class="text-primary">Flow</span>
                    </a>

                    <p class="text-body-secondary small mb-0 mt-1">
                        Einfach planen. Besser arbeiten.
                    </p>
                </div>

                <div class="col-12 col-md-6 text-center text-md-end">
                    <span class="text-body-secondary small">
                        &copy; @DateTime.Now.Year TaskFlow. Alle Rechte vorbehalten.
                    </span>
                </div>

            </div>

        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
